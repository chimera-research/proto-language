diff --git a/proto_tools/tools/molecular_generation/synflownet/standalone/inference.py b/proto_tools/tools/molecular_generation/synflownet/standalone/inference.py
new file mode 100644
index 00000000..9c109d3f
--- /dev/null
+++ b/proto_tools/tools/molecular_generation/synflownet/standalone/inference.py
@@ -0,0 +1,301 @@
+"""SynFlowNet synthesizable-molecule sampling (standalone inference)."""
+
+import gc
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+from standalone_helpers import get_logger, get_random_int, resolve_weights_dir, serialize_output, set_torch_seed
+
+logger = get_logger(__name__)
+
+# Checkpoint filename SynFlowNet writes under its run directory; also the name we look
+# for in the managed weights cache when model_checkpoint == "default".
+DEFAULT_CHECKPOINT_NAME = "model_state.pt"
+
+
+def _resolve_checkpoint(model_checkpoint: str) -> str:
+    """Resolve the checkpoint path, honoring the managed weights cache for 'default'."""
+    if model_checkpoint != "default":
+        if not Path(model_checkpoint).is_file():
+            raise FileNotFoundError(f"synflownet: checkpoint not found at {model_checkpoint!r}")
+        return model_checkpoint
+    weights_dir = resolve_weights_dir("synflownet")
+    if weights_dir is None:
+        raise FileNotFoundError("synflownet: could not resolve a weights directory for the default checkpoint")
+    candidate = Path(weights_dir) / DEFAULT_CHECKPOINT_NAME
+    if not candidate.is_file():
+        raise FileNotFoundError(
+            f"synflownet: default checkpoint {candidate} not found; provision a trained SynFlowNet "
+            f"checkpoint there or pass an explicit model_checkpoint path."
+        )
+    return str(candidate)
+
+
+class SynFlowNetModel:
+    """Loads a trained SynFlowNet GFlowNet and samples molecules from its policy."""
+
+    def __init__(self, checkpoint_path: str) -> None:
+        """Initialize lazy model state keyed on the resolved checkpoint path."""
+        self.checkpoint_path = checkpoint_path
+        self._loaded = False
+        self.device: str | None = None
+        self._trial: Any = None
+        self._model: Any = None
+        self._ctx: Any = None
+        self._env: Any = None
+        self._task: Any = None
+        self._sampler: Any = None
+
+    def load(self, device: str) -> None:
+        """Restore the trainer from the checkpoint and move the policy model to ``device``."""
+        import torch
+        from synflownet.tasks.reactions_task import ReactionTrainer
+
+        logger.update_status("Loading SynFlowNet checkpoint")
+        # SynFlowNet rebuilds env/ctx/task/sampler from the checkpoint's stored config.
+        trial = ReactionTrainer.load_from_checkpoint(self.checkpoint_path)
+        self._trial = trial
+        # The exponential-moving-average sampling model is preferred for generation; fall back
+        # to the trained policy model when a trainer build doesn't expose one.
+        self._model = getattr(trial, "sampling_model", None) or trial.model
+        self._ctx = trial.ctx
+        self._env = trial.env
+        self._task = trial.task
+        self._sampler = trial.sampler
+
+        self._model.eval()
+        self._model.to(device)
+        if device.startswith("cuda") and torch.cuda.is_available():
+            torch.cuda.set_device(device)
+        self.device = device
+        self._loaded = True
+
+    def sample(
+        self,
+        num_molecules: int,
+        sampling_temperature: float,
+        random_action_prob: float,
+        max_reaction_steps: int,
+        objective: str | None = None,
+        seed: int | None = None,
+        device: str = "cuda",
+        verbose: bool = False,
+        **_: Any,
+    ) -> dict[str, Any]:
+        """Sample molecules from the trained GFlowNet policy.
+
+        Args:
+            num_molecules: Number of molecules (trajectories) to sample.
+            sampling_temperature: GFlowNet inverse-temperature (beta); overrides the
+                checkpoint's conditioning distribution with this constant.
+            random_action_prob: Probability of a uniform-random action per step.
+            max_reaction_steps: Maximum synthesis actions per molecule.
+            objective: Optional named reward objective for multi-objective checkpoints.
+            seed: Random seed; a concrete int is drawn when None.
+            device: Device to run on ('cuda' or 'cpu').
+            verbose: Whether to log status messages.
+
+        Returns:
+            dict[str, Any]: ``{"molecules": [{"smiles", "synthesis_route",
+                "building_blocks", "metrics"}, ...]}`` with one entry per valid molecule.
+        """
+        import torch
+        from rdkit import Chem
+        from rdkit.Chem import QED, Descriptors
+
+        set_torch_seed(seed)
+        sampling_seed = seed if seed is not None else get_random_int()
+
+        if not self._loaded or self.device != device:
+            self.load(device)
+        if objective is not None and verbose:
+            logger.info("synflownet: objective=%r (effective only for objective-conditioned checkpoints)", objective)
+
+        # Bound trajectory length to the requested number of synthesis steps.
+        self._sampler.max_len = max_reaction_steps
+
+        # Constant inverse-temperature conditioning at the requested beta.
+        cond_info = self._build_cond_info(num_molecules, sampling_temperature, device)
+
+        torch.manual_seed(sampling_seed)
+        with torch.no_grad():
+            trajectories = self._sampler.sample_from_model(
+                self._model,
+                num_molecules,
+                cond_info,
+                random_action_prob=random_action_prob,
+            )
+
+        mols: list[Any] = []
+        valid_trajs: list[dict[str, Any]] = []
+        for traj in trajectories:
+            if not traj.get("is_valid", False):
+                continue
+            mol = self._ctx.graph_to_obj(traj["result"])
+            if mol is None:
+                continue
+            mols.append(mol)
+            valid_trajs.append(traj)
+
+        rewards = self._rewards_for(mols, valid_trajs)
+
+        molecules: list[dict[str, Any]] = []
+        for mol, traj, reward in zip(mols, valid_trajs, rewards, strict=True):
+            smiles = Chem.MolToSmiles(mol)
+            route, building_blocks = _route_and_blocks(traj)
+            try:
+                qed = float(QED.qed(mol))
+            except Exception:  # QED can fail on exotic valences; drop the key rather than fail the batch
+                qed = float("nan")
+            molecules.append(
+                {
+                    "smiles": smiles,
+                    "synthesis_route": route,
+                    "building_blocks": building_blocks,
+                    "metrics": {
+                        "reward": reward,
+                        "num_reactions": float(len(traj.get("traj", []))),
+                        "qed": qed,
+                        "molecular_weight": float(Descriptors.MolWt(mol)),
+                    },
+                }
+            )
+
+        self.unload()
+        return {"molecules": molecules}
+
+    def _build_cond_info(self, n: int, beta: float, device: str) -> Any:
+        """Build a constant inverse-temperature conditioning tensor for ``n`` samples."""
+        import torch
+
+        # Ask the task to encode a constant beta so the policy samples at the requested
+        # temperature regardless of the distribution the checkpoint was trained with.
+        temperature_conditional = getattr(self._task, "temperature_conditional", None)
+        if temperature_conditional is not None and hasattr(temperature_conditional, "encode"):
+            beta_tensor = torch.full((n,), float(beta))
+            encoding = temperature_conditional.encode(beta_tensor)
+            return encoding.to(device)
+        # Fall back to the task's own conditional sampling (final=True uses a high constant beta).
+        cond_info = self._task.sample_conditional_information(n, 0, final=True)
+        return cond_info["encoding"].to(device)
+
+    def _rewards_for(self, mols: list[Any], trajs: list[dict[str, Any]]) -> list[float]:
+        """Compute the task reward per molecule, falling back to the sampler's reward_pred."""
+        if not mols:
+            return []
+        traj_lens = [len(t.get("traj", [])) for t in trajs]
+        try:
+            obj_properties, _is_valid = self._task.compute_obj_properties(mols, traj_lens)
+            flat = obj_properties.flatten().tolist() if hasattr(obj_properties, "flatten") else list(obj_properties)
+            if len(flat) == len(mols):
+                return [float(x) for x in flat]
+        except Exception as exc:  # proxy failures shouldn't sink an otherwise-valid sample
+            logger.warning("synflownet: task reward computation failed (%s); using sampler reward_pred", exc)
+        return [float(t.get("reward_pred", float("nan"))) for t in trajs]
+
+    def to_device(self, device: str) -> None:
+        """Move the policy model to a different device."""
+        import torch
+
+        if not self._loaded:
+            raise ValueError("synflownet: cannot move an unloaded model to device — call load() first")
+        if self.device != device:
+            self._model.to(device)
+            if device.startswith("cuda") and torch.cuda.is_available():
+                torch.cuda.set_device(device)
+            self.device = device
+
+    def unload(self) -> None:
+        """Release the policy model and cached GPU memory."""
+        import torch
+
+        self._trial = None
+        self._model = None
+        self._ctx = None
+        self._env = None
+        self._task = None
+        self._sampler = None
+        self._loaded = False
+        self.device = None
+        gc.collect()
+        if torch.cuda.is_available():
+            torch.cuda.empty_cache()
+
+
+def _route_and_blocks(traj: dict[str, Any]) -> tuple[list[str], list[str]]:
+    """Extract a human-readable synthesis route and building-block SMILES from a trajectory."""
+    route: list[str] = []
+    for entry in traj.get("traj", []):
+        action = entry[1] if isinstance(entry, (list, tuple)) and len(entry) > 1 else None
+        if action is not None:
+            route.append(str(getattr(action, "action", action)))
+    building_blocks: list[str] = [bb if isinstance(bb, str) else str(bb) for bb in (traj.get("bbs") or [])]
+    return route, building_blocks
+
+
+# ============================================================================
+# Dispatch
+# ============================================================================
+_model: SynFlowNetModel | None = None
+_model_checkpoint: str | None = None
+
+
+def dispatch(input_dict: dict[str, Any]) -> dict[str, Any]:
+    """Entry point for both persistent-worker and one-shot execution."""
+    global _model, _model_checkpoint
+
+    checkpoint_path = _resolve_checkpoint(input_dict["model_checkpoint"])
+    if _model is not None and _model_checkpoint != checkpoint_path:
+        _model.unload()
+        _model = None
+        _model_checkpoint = None
+    if _model is None:
+        _model = SynFlowNetModel(checkpoint_path=checkpoint_path)
+        _model_checkpoint = checkpoint_path
+
+    operation = input_dict["operation"]
+    if operation == "sample":
+        return _model.sample(
+            num_molecules=input_dict["num_molecules"],
+            sampling_temperature=input_dict["sampling_temperature"],
+            random_action_prob=input_dict["random_action_prob"],
+            max_reaction_steps=input_dict["max_reaction_steps"],
+            objective=input_dict.get("objective"),
+            seed=input_dict.get("seed"),
+            device=input_dict["device"],
+            verbose=input_dict["verbose"],
+        )
+    raise ValueError(f"synflownet: unknown operation {operation!r}; valid: ['sample']")
+
+
+def to_device(device: str) -> dict[str, Any]:
+    """Move model to specified device (called by DeviceManager)."""
+    global _model
+    if _model is not None and _model._loaded:
+        _model.to_device(device)
+        return {"success": True, "device": device}
+    return {"success": True, "device": device, "note": "model not loaded yet"}
+
+
+def get_memory_stats() -> dict[str, Any]:
+    """Report GPU memory usage (called by DeviceManager for monitoring)."""
+    from standalone_helpers import get_pytorch_memory_stats
+
+    global _model
+    device = _model.device if _model and _model.device is not None else 0
+    return get_pytorch_memory_stats(device)  # type: ignore[no-any-return]
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 3:
+        raise ValueError("synflownet: usage: python inference.py <input_json_path> <output_json_path>")
+
+    with open(sys.argv[1]) as f:
+        input_data = json.load(f)
+
+    result = dispatch(input_data)
+
+    with open(sys.argv[2], "w") as f:
+        json.dump(serialize_output(result), f)
