+"""tests/molecular_generation_tests/test_synflownet_sample.py.
+
+Tests for SynFlowNet synthesizable-molecule sampling.
+"""
+
+import csv
+import json
+from pathlib import Path
+
+import pytest
+
+from proto_tools.tools.molecular_generation import (
+    SynFlowNetMolecule,
+    SynFlowNetMoleculeMetrics,
+    SynFlowNetSampleConfig,
+    SynFlowNetSampleInput,
+    SynFlowNetSampleOutput,
+    SynFlowNetSampleSet,
+    run_synflownet_sample,
+)
+from tests.conftest import benchmark_twice
+
+
+def _molecule(smiles: str, reward: float) -> SynFlowNetMolecule:
+    """Build a molecule with populated metrics for export tests."""
+    return SynFlowNetMolecule(
+        smiles=smiles,
+        metrics=SynFlowNetMoleculeMetrics(
+            reward=reward,
+            num_reactions=2,
+            qed=0.6,
+            molecular_weight=46.0,
+        ),
+    )
+
+
+def _two_set_output() -> SynFlowNetSampleOutput:
+    """Two sample sets, each with two molecules, built without running the model."""
+    return SynFlowNetSampleOutput(
+        sample_sets=[
+            SynFlowNetSampleSet(
+                molecules=[_molecule("CCO", 1.2), _molecule("CCC", 0.9)],
+                objective="seh",
+            ),
+            SynFlowNetSampleSet(
+                molecules=[_molecule("c1ccccc1", 1.5), _molecule("CCN", 0.4)],
+                objective=None,
+            ),
+        ]
+    )
+
+
+# normalize_requests before-validator
+
+
+def test_normalize_requests_bare_string_becomes_single_request() -> None:
+    """A bare objective string coerces to one request carrying that objective."""
+    inputs = SynFlowNetSampleInput(requests="seh")  # type: ignore[arg-type]
+
+    assert len(inputs.requests) == 1
+    assert inputs.requests[0].objective == "seh"
+
+
+def test_normalize_requests_list_of_strings_becomes_one_request_each() -> None:
+    """A list of objective strings yields one request per entry, preserving order."""
+    inputs = SynFlowNetSampleInput(requests=["seh", "qed"])  # type: ignore[list-item]
+
+    assert [req.objective for req in inputs.requests] == ["seh", "qed"]
+
+
+@pytest.mark.parametrize("value", [None, []])
+def test_normalize_requests_empty_input_yields_one_default_request(value: object) -> None:
+    """None or an empty list collapses to a single default (native-reward) request."""
+    inputs = SynFlowNetSampleInput(requests=value)  # type: ignore[arg-type]
+
+    assert len(inputs.requests) == 1
+    assert inputs.requests[0].objective is None
+    assert inputs.requests[0].label is None
+
+
+# remote_unsupported_reason custom method
+
+
+def test_remote_unsupported_reason_allows_default_checkpoint() -> None:
+    """The provisioned 'default' checkpoint is available on every hosted worker."""
+    config = SynFlowNetSampleConfig(model_checkpoint="default")
+
+    assert config.remote_unsupported_reason("modal") is None
+    assert config.remote_unsupported_reason("proto") is None
+
+
+@pytest.mark.parametrize("device", ["modal", "proto"])
+def test_remote_unsupported_reason_blocks_local_checkpoint(device: str) -> None:
+    """A user-supplied checkpoint path cannot be served remotely, so a reason is returned."""
+    config = SynFlowNetSampleConfig(model_checkpoint="local/models/my_checkpoint.pt")
+
+    reason = config.remote_unsupported_reason(device)  # type: ignore[arg-type]
+    assert reason is not None
+    assert device in reason
+
+
+# Output flattening and export round-trip (no model execution)
+
+
+def test_output_molecules_and_smiles_flatten_across_sample_sets() -> None:
+    """The output flattens molecules and SMILES across every sample set, in order."""
+    output = _two_set_output()
+
+    assert len(output.molecules) == 4
+    assert output.smiles == ["CCO", "CCC", "c1ccccc1", "CCN"]
+
+
+def test_output_exports_smi_as_one_smiles_per_line(tmp_path: Path) -> None:
+    """The .smi export writes exactly one SMILES per molecule, one per line."""
+    output = _two_set_output()
+
+    output.export("sample", tmp_path, file_format="smi")
+
+    lines = (tmp_path / "sample.smi").read_text().splitlines()
+    assert lines == ["CCO", "CCC", "c1ccccc1", "CCN"]
+
+
+def test_output_exports_csv_with_header_and_one_row_per_molecule(tmp_path: Path) -> None:
+    """The .csv export has the documented header and one row per molecule with its metrics."""
+    output = _two_set_output()
+
+    output.export("sample", tmp_path, file_format="csv")
+
+    with (tmp_path / "sample.csv").open() as handle:
+        rows = list(csv.DictReader(handle))
+
+    assert [row["smiles"] for row in rows] == ["CCO", "CCC", "c1ccccc1", "CCN"]
+    assert rows[0]["objective"] == "seh"
+    assert rows[2]["objective"] == ""  # second set's objective is None -> empty string
+    assert rows[0]["reward"] == "1.2"
+    assert rows[0]["qed"] == "0.6"
+    assert rows[0]["molecular_weight"] == "46.0"
+
+
+def test_output_exports_valid_json_round_trip(tmp_path: Path) -> None:
+    """The .json export is valid JSON that preserves sample-set structure and metrics."""
+    output = _two_set_output()
+
+    output.export("sample", tmp_path, file_format="json")
+
+    data = json.loads((tmp_path / "sample.json").read_text())
+    assert len(data["sample_sets"]) == 2
+    assert data["sample_sets"][0]["objective"] == "seh"
+    assert data["sample_sets"][0]["molecules"][0]["smiles"] == "CCO"
+    assert data["sample_sets"][0]["molecules"][0]["metrics"]["reward"] == 1.2
+
+
