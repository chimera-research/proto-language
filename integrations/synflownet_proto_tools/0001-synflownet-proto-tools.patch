+"""proto_tools/tools/molecular_generation/synflownet/synflownet_sample.py.
+
+SynFlowNet synthesizable-molecule sampling tool.
+"""
+
+import csv
+import json
+import logging
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any, ClassVar
+
+from pydantic import BaseModel, ConfigDict, Field, field_validator
+
+from proto_tools.tools.tool_registry import tool
+from proto_tools.utils import BaseConfig, BaseToolInput, BaseToolOutput, ConfigField, InputField, ToolInstance
+from proto_tools.utils.device import RemoteDevice
+from proto_tools.utils.progress import progress_bar
+from proto_tools.utils.tool_io import Metrics, MetricSpec
+
+logger = logging.getLogger(__name__)
+
+# Sentinel meaning "use the checkpoint provisioned in the managed weights cache"
+# (``resolve_weights_dir('synflownet')/model_state.pt``). Any other value is treated
+# as an explicit path to a user-supplied SynFlowNet checkpoint.
+DEFAULT_CHECKPOINT = "default"
+
+
+# ============================================================================
+# Data Models
+# ============================================================================
+class SynFlowNetRequest(BaseModel):
+    """One molecule-generation request handled by a single SynFlowNet sampling pass.
+
+    Attributes:
+        objective (str | None): Optional named reward objective to condition on,
+            for checkpoints trained to switch objectives at inference (e.g.
+            ``"seh"``, ``"qed"``). ``None`` samples from the checkpoint's native
+            reward.
+        label (str | None): Optional free-form label echoed back on the matching
+            sample set, to tag requests in multi-request batches.
+    """
+
+    model_config = ConfigDict(extra="forbid")
+
+    objective: str | None = Field(
+        default=None,
+        title="Objective",
+        description="Named reward objective for multi-objective checkpoints; None uses the native reward.",
+    )
+    label: str | None = Field(
+        default=None,
+        title="Label",
+        description="Optional label echoed on the matching sample set.",
+    )
+
+
+class SynFlowNetSampleInput(BaseToolInput):
+    """Input for the SynFlowNet sampling tool.
+
+    Attributes:
+        requests (list[SynFlowNetRequest]): Generation requests; each produces one
+            sample set of ``num_molecules_per_request`` molecules. A bare string
+            or list of strings is coerced to requests carrying those objectives;
+            an empty input yields a single default request.
+    """
+
+    requests: list[SynFlowNetRequest] = InputField(
+        default_factory=lambda: [SynFlowNetRequest()],
+        title="Requests",
+        description="Generation requests; each yields one sample set of molecules.",
+    )
+
+    @field_validator("requests", mode="before")
+    @classmethod
+    def normalize_requests(cls, value: Any) -> Any:
+        """Coerce a bare objective string, a list of strings, or empty input to requests."""
+        if value is None or value == []:
+            return [SynFlowNetRequest()]
+        items = value if isinstance(value, (list, tuple)) else [value]
+        return [{"objective": item} if isinstance(item, str) else item for item in items]
+
+
+class SynFlowNetSampleConfig(BaseConfig):
+    """Configuration for SynFlowNet molecule sampling.
+
+    Attributes:
+        model_checkpoint (str): Trained SynFlowNet GFlowNet checkpoint. ``"default"``
+            uses the checkpoint provisioned in the managed weights cache; any other
+            value is an explicit path to a ``.pt`` checkpoint.
+        num_molecules_per_request (int): Molecules to generate per request.
+        sampling_temperature (float): Inverse-temperature (beta) for the GFlowNet
+            policy; higher concentrates sampling on high-reward molecules, lower
+            broadens diversity.
+        random_action_prob (float): Probability of taking a uniform-random synthesis
+            action at each step, for extra exploration.
+        max_reaction_steps (int): Maximum number of synthesis actions per molecule
+            (trajectory length).
+        unique_molecules (bool): Deduplicate identical canonical SMILES within a
+            request (oversampling to still return the requested count where possible).
+        batch_size (int): Molecules sampled per GFlowNet forward pass; raise for
+            throughput, lower if out of GPU memory.
+        device (str): Device to run the model on.
+    """
+
+    model_checkpoint: str = ConfigField(
+        title="Model Checkpoint",
+        default=DEFAULT_CHECKPOINT,
+        description="'default' uses the provisioned checkpoint, or a path to a .pt SynFlowNet checkpoint.",
+        reload_on_change=True,
+    )
+    num_molecules_per_request: int = ConfigField(
+        title="Molecules Per Request",
+        default=64,
+        ge=1,
+        description="Number of molecules to generate per request.",
+    )
+    sampling_temperature: float = ConfigField(
+        title="Sampling Temperature",
+        default=32.0,
+        gt=0.0,
+        description="GFlowNet inverse-temperature (beta); higher favors high-reward molecules.",
+    )
+    random_action_prob: float = ConfigField(
+        title="Random Action Probability",
+        default=0.0,
+        ge=0.0,
+        le=1.0,
+        description="Probability of a uniform-random synthesis action per step, for exploration.",
+    )
+    max_reaction_steps: int = ConfigField(
+        title="Max Reaction Steps",
+        default=4,
+        ge=1,
+        description="Maximum synthesis actions per molecule (trajectory length).",
+    )
+    unique_molecules: bool = ConfigField(
+        title="Unique Molecules",
+        default=True,
+        description="Deduplicate identical canonical SMILES within a request.",
+    )
+    batch_size: int = ConfigField(
+        title="Batch Size",
+        default=64,
+        ge=1,
+        description="Molecules per GFlowNet forward pass; raise for throughput, lower if OOM.",
+    )
+    device: str = ConfigField(
+        title="Device",
+        default="cuda",
+        description="Device to run the model on",
+        include_in_key=False,
+    )
+
+    def remote_unsupported_reason(self, device: RemoteDevice) -> str | None:
+        """A user-supplied checkpoint path isn't present on a hosted worker."""
+        if self.model_checkpoint != DEFAULT_CHECKPOINT:
+            return (
+                f"model_checkpoint points to a local checkpoint not available on device='{device}'. "
+                "Use the provisioned 'default' checkpoint, or run locally with device='cuda'."
+            )
+        return None
+
+
+class SynFlowNetMoleculeMetrics(Metrics):
+    """Per-molecule metrics for a SynFlowNet-generated molecule.
+
+    Metrics documented in ``metric_spec``:
+        reward (float): GFlowNet task reward for the molecule under the checkpoint's
+            objective. Higher is better.
+        num_reactions (float): Number of synthesis reactions in the molecule's route.
+            Context for synthesizability, not a quality score.
+        qed (float): RDKit quantitative estimate of drug-likeness (0-1). Higher is
+            more drug-like.
+        molecular_weight (float): Molecular weight in g/mol. Context, not a score.
+    """
+
+    metric_spec: ClassVar[dict[str, MetricSpec]] = {
+        "reward": {
+            "availability": "always",
+            "type": "float",
+            "min": 0.0,
+            "max": None,
+            "better_values_are": "higher",
+        },
+        "num_reactions": {
+            "availability": "always",
+            "type": "float",
+            "min": 0.0,
+            "max": None,
+            "better_values_are": "context-dependent",
+        },
+        "qed": {
+            "availability": "when RDKit can compute QED for the molecule",
+            "type": "float",
+            "min": 0.0,
+            "max": 1.0,
+            "better_values_are": "higher",
+        },
+        "molecular_weight": {
+            "availability": "when RDKit can parse the molecule",
+            "type": "float",
+            "min": 0.0,
+            "max": None,
+            "unit": "g/mol",
+            "better_values_are": "context-dependent",
+        },
+    }
+    primary_metric: str | None = Field(
+        default="reward",
+        title="Primary Metric",
+        description="Headline metric used to rank molecules.",
+    )
+
+
+class SynFlowNetMolecule(BaseModel):
+    """One molecule generated by SynFlowNet, with its synthesis route and metrics.
+
+    Attributes:
+        smiles (str): Canonical SMILES of the generated molecule.
+        synthesis_route (list[str]): Ordered reaction templates applied to build the
+            molecule, as reported by the sampler (empty if unavailable).
+        building_blocks (list[str]): SMILES of the building blocks consumed by the
+            synthesis route (empty if unavailable).
+        metrics (SynFlowNetMoleculeMetrics): Per-molecule reward and property metrics.
+    """
+
+    model_config = ConfigDict(extra="forbid")
+
+    smiles: str = Field(title="SMILES", description="Canonical SMILES of the generated molecule")
+    synthesis_route: list[str] = Field(
+        default_factory=list,
+        title="Synthesis Route",
+        description="Ordered reaction templates applied to build the molecule",
+    )
+    building_blocks: list[str] = Field(
+        default_factory=list,
+        title="Building Blocks",
+        description="SMILES of the building blocks used in the synthesis route",
+    )
+    metrics: SynFlowNetMoleculeMetrics = Field(
+        default_factory=SynFlowNetMoleculeMetrics,
+        title="Metrics",
+        description="Per-molecule reward and property metrics.",
+    )
+
+
+class SynFlowNetSampleSet(BaseModel):
+    """All molecules generated for a single request, in sampling order.
+
+    Attributes:
+        molecules (list[SynFlowNetMolecule]): The molecules generated for one request.
+        objective (str | None): The request's objective, echoed back.
+        label (str | None): The request's label, echoed back.
+    """
+
+    model_config = ConfigDict(extra="forbid")
+
+    molecules: list[SynFlowNetMolecule] = Field(
+        title="Molecules",
+        description="Molecules generated for one request, in sampling order.",
+    )
+    objective: str | None = Field(
+        default=None,
+        title="Objective",
+        description="Objective of the request that produced these molecules.",
+    )
+    label: str | None = Field(
+        default=None,
+        title="Label",
+        description="Label of the request that produced these molecules.",
+    )
+
+    def __len__(self) -> int:
+        return len(self.molecules)
+
+    def __getitem__(self, index: int) -> SynFlowNetMolecule:
+        return self.molecules[index]
+
+    def __iter__(self) -> Iterator[SynFlowNetMolecule]:  # type: ignore[override]
+        return iter(self.molecules)
+
+
+class SynFlowNetSampleOutput(BaseToolOutput):
+    """Output of the SynFlowNet sampling tool.
+
+    Attributes:
+        sample_sets (list[SynFlowNetSampleSet]): One sample set per input request,
+            in input order.
+    """
+
+    sample_sets: list[SynFlowNetSampleSet] = Field(
+        title="Sample Sets",
+        description="One SynFlowNetSampleSet per input request, in input order.",
+    )
+
+    @property
+    def molecules(self) -> list[SynFlowNetMolecule]:
+        """All generated molecules across every sample set, in order."""
+        return [mol for sample_set in self.sample_sets for mol in sample_set.molecules]
+
+    @property
+    def smiles(self) -> list[str]:
+        """Canonical SMILES of every generated molecule, in order."""
+        return [mol.smiles for mol in self.molecules]
+
+    @property
+    def output_format_options(self) -> list[str]:
+        """Return the supported output format options."""
+        return ["smi", "csv", "json"]
+
+    @property
+    def output_format_default(self) -> str:
+        """Return the default output format."""
+        return "smi"
+
+    def _export_output(self, export_path: str | Path, file_format: str) -> None:
+        path = Path(export_path).with_suffix(f".{file_format}")
+
+        if file_format == "smi":
+            path.write_text("".join(f"{mol.smiles}\n" for mol in self.molecules))
+        elif file_format == "csv":
+            with open(path, "w", newline="") as f:
+                writer = csv.writer(f)
+                writer.writerow(["smiles", "objective", "reward", "num_reactions", "qed", "molecular_weight"])
+                for sample_set in self.sample_sets:
+                    for mol in sample_set.molecules:
+                        writer.writerow(
+                            [
+                                mol.smiles,
+                                sample_set.objective or "",
+                                mol.metrics.get("reward"),
+                                mol.metrics.get("num_reactions"),
+                                mol.metrics.get("qed"),
+                                mol.metrics.get("molecular_weight"),
+                            ]
+                        )
+        elif file_format == "json":
+            path.write_text(json.dumps(self.model_dump(mode="json"), indent=2))
+        else:
+            raise ValueError(f"Unsupported format: {file_format}")
+
+
+# ============================================================================
+# Tool Implementation
+# ============================================================================
+def example_input() -> Any:
+    """Minimal valid input for testing and examples."""
+    return SynFlowNetSampleInput(requests=[SynFlowNetRequest()])
+
+
+def _molecules_from_dicts(raw_molecules: list[dict[str, Any]]) -> list[SynFlowNetMolecule]:
+    """Build typed molecules from the standalone's per-molecule dicts."""
+    molecules: list[SynFlowNetMolecule] = []
+    for raw in raw_molecules:
+        metrics = raw.get("metrics", {})
+        molecules.append(
+            SynFlowNetMolecule(
+                smiles=raw["smiles"],
+                synthesis_route=raw.get("synthesis_route", []),
+                building_blocks=raw.get("building_blocks", []),
+                metrics=SynFlowNetMoleculeMetrics(**metrics),
+            )
+        )
+    return molecules
+
+
+@tool(
+    key="synflownet-sample",
+    label="SynFlowNet Molecule Sampling",
+    category="molecular_generation",
+    input_class=SynFlowNetSampleInput,
+    config_class=SynFlowNetSampleConfig,
+    output_class=SynFlowNetSampleOutput,
+    metrics_class=SynFlowNetMoleculeMetrics,
+    description="Generate synthesizable small molecules with a SynFlowNet GFlowNet",
+    uses_gpu=True,
+    device_count="1",
+    example_input=example_input,
+    iterable_input_fields=["requests"],
+    iterable_output_field="sample_sets",
+    max_chunk_size=1,
+    cacheable=True,
+    stochastic=True,
+)
+def run_synflownet_sample(
+    inputs: SynFlowNetSampleInput,
+    config: SynFlowNetSampleConfig,
+    instance: Any = None,
+) -> SynFlowNetSampleOutput:
+    """Generate synthesizable small molecules with a SynFlowNet GFlowNet.
+
+    Args:
+        inputs (SynFlowNetSampleInput): Generation requests, one sample set produced per request.
+        config (SynFlowNetSampleConfig): Sampling configuration (checkpoint, count, temperature, etc.).
+        instance (Any): Optional ToolInstance for subprocess execution.
+
+    Returns:
+        SynFlowNetSampleOutput: One SynFlowNetSampleSet per request, each holding the
+            generated molecules with their synthesis routes and metrics.
+    """
+    logger.debug("Using local venv for synflownet sampling")
+
+    base_seed = config.seed if config.seed is not None else config.get_random_int()
+    # Advances across every dispatch (requests x chunks) so duplicate requests diverge.
+    dispatch_idx = 0
+
+    sample_sets: list[SynFlowNetSampleSet] = []
+    for request in progress_bar(
+        inputs.requests,
+        desc="SynFlowNet sampling",
+        unit="request",
+        total=len(inputs.requests),
+    ):
+        collected: list[SynFlowNetMolecule] = []
+        seen_smiles: set[str] = set()
+        target = config.num_molecules_per_request
+        # Cap total dispatches so uniqueness filtering on a low-diversity checkpoint
+        # can't loop forever; without dedup this is exactly ceil(target / batch_size).
+        max_dispatches = max(1, -(-target // config.batch_size)) * (4 if config.unique_molecules else 1)
+        dispatches = 0
+        while len(collected) < target and dispatches < max_dispatches:
+            chunk = min(config.batch_size, target - len(collected))
+            input_dict = {
+                "operation": "sample",
+                "model_checkpoint": config.model_checkpoint,
+                "objective": request.objective,
+                "num_molecules": chunk,
+                "sampling_temperature": config.sampling_temperature,
+                "random_action_prob": config.random_action_prob,
+                "max_reaction_steps": config.max_reaction_steps,
+                "seed": base_seed + dispatch_idx,
+                "device": config.device,
+                "verbose": config.verbose,
+            }
+            result = ToolInstance.dispatch("synflownet", input_dict, instance=instance, config=config)
+            for mol in _molecules_from_dicts(result["molecules"]):
+                if config.unique_molecules and mol.smiles in seen_smiles:
+                    continue
+                seen_smiles.add(mol.smiles)
+                collected.append(mol)
+            dispatch_idx += 1
+            dispatches += 1
+
+        if len(collected) < target:
+            logger.warning(
+                "SynFlowNet returned %d of %d requested molecules for objective=%r after %d dispatches.",
+                len(collected),
+                target,
+                request.objective,
+                dispatches,
+            )
+        molecules = collected[:target]
+        sample_sets.append(
+            SynFlowNetSampleSet(molecules=molecules, objective=request.objective, label=request.label)
+        )
+
+    return SynFlowNetSampleOutput(sample_sets=sample_sets)
