--- /dev/null
+++ b/proto_tools/tools/molecular_generation/synflownet/standalone/setup.sh
@@ -0,0 +1,52 @@
+#!/bin/bash
+# Setup script for the SynFlowNet standalone environment.
+#
+# SynFlowNet generates molecules from a *trained* GFlowNet checkpoint. There are no
+# publicly distributed weights, so the checkpoint is user-provisioned: train a model
+# with the upstream repo (https://github.com/mirunacrt/synflownet) and either drop the
+# resulting model_state.pt into the managed weights cache, or point
+# PROTO_SYNFLOWNET_WEIGHTS_DIR (or PROTO_MODEL_CACHE/synflownet) at a directory that
+# contains it. The building-block and reaction-template data ship with the upstream
+# package under synflownet/data/.
+set -euo pipefail
+source standalone_helpers.sh
+
+echo "Setting up SynFlowNet standalone environment..."
+
+# SynFlowNet pins torch 2.1.2 + torch-geometric wheels built against it.
+proto_install_pytorch "torch==2.1.2"
+
+echo "Installing SynFlowNet and dependencies..."
+# torch-geometric companion wheels are served from the pyg index for the installed torch.
+uv pip install -r requirements.txt --find-links "https://data.pyg.org/whl/torch-2.1.2+cpu.html"
+
+# ─── Checkpoint provisioning precheck ───────────────────────────────────────
+# Resolve the same location the runtime resolves for the 'default' checkpoint: the
+# managed weights cache, honoring PROTO_SYNFLOWNET_WEIGHTS_DIR and PROTO_MODEL_CACHE.
+proto_resolve_weights_dir synflownet   # sets $WEIGHTS_DIR
+checkpoint_configured=""
+[ -n "${PROTO_SYNFLOWNET_WEIGHTS_DIR:-}" ] && checkpoint_configured="yes"
+
+if [ -f "${WEIGHTS_DIR}/model_state.pt" ]; then
+    echo "[synflownet] Using trained checkpoint at ${WEIGHTS_DIR}/model_state.pt"
+elif [ -n "$checkpoint_configured" ]; then
+    echo "ERROR: PROTO_SYNFLOWNET_WEIGHTS_DIR is set but model_state.pt was not found there." >&2
+    echo "Point it at a directory containing a trained SynFlowNet model_state.pt." >&2
+    exit 1
+else
+    {
+        echo "[proto-tools] ASSET_NOT_AVAILABLE: synflownet:checkpoint"
+        echo "A trained SynFlowNet checkpoint (model_state.pt) is not provisioned; it is required"
+        echo "by the synflownet-sample tool when model_checkpoint='default'."
+        echo "Provisioning steps:"
+        echo "  1. Train a model with the upstream repo (https://github.com/mirunacrt/synflownet),"
+        echo "     which writes ./logs/<name>/model_state.pt."
+        echo "  2. Copy that model_state.pt into the managed cache so it is found automatically"
+        echo "     (no environment variable needed), or set PROTO_SYNFLOWNET_WEIGHTS_DIR to the"
+        echo "     directory that contains it."
+        echo "  Alternatively, pass model_checkpoint='<path-to-your-checkpoint.pt>' per call."
+    } >&2
+    exit 64
+fi
+
+echo "SynFlowNet setup complete!"
