--- /dev/null
+++ b/proto_tools/tools/molecular_generation/drugflow/standalone/setup.sh
@@ -0,0 +1,52 @@
+#!/bin/bash
+# Provisioning script for the DrugFlow standalone environment.
+#
+# DrugFlow (MIT, https://github.com/LPDI-EPFL/DrugFlow) is CLI-only, so this env clones the repo
+# and the driver shells out to src/generate.py. The env mirrors the upstream conda environment.yaml
+# (torch 2.2.1/cu121, PyG 2.5.1, openbabel 3.1.1, rdkit, prody, posebusters, ...). Model checkpoints
+# are public on Zenodo (record 14919171) and are downloaded into the managed weights cache.
+set -euo pipefail
+source standalone_helpers.sh
+
+echo "Setting up DrugFlow standalone environment..."
+
+# DrugFlow pins torch 2.2.1 built against CUDA 12.1.
+proto_install_cuda_toolkit "12.1.*"
+proto_install_pytorch "torch==2.2.1"
+
+# PyTorch Geometric stack, matched to torch 2.2.1 + cu121 companion wheels.
+echo "Installing PyTorch Geometric stack..."
+uv pip install "torch-scatter==2.1.2" "torch-geometric==2.5.1" \
+    --find-links "https://data.pyg.org/whl/torch-2.2.1+cu121.html"
+
+# openbabel has no reliable pip wheel; install it from conda-forge into the venv (DrugFlow's
+# evaluation/interaction code imports it).
+echo "Installing openbabel via conda-forge..."
+"$MAMBA_BIN" install -y -p "$VENV_PATH" -c conda-forge "openbabel=3.1.1"
+
+echo "Installing pinned Python dependencies..."
+uv pip install -r requirements.txt
+
+# Clone DrugFlow. Pin DRUGFLOW_COMMIT to a reviewed commit before shipping; defaults to main.
+DRUGFLOW_DIR="${VENV_PATH}/data/DrugFlow"
+DRUGFLOW_COMMIT="${DRUGFLOW_COMMIT:-main}"
+mkdir -p "${VENV_PATH}/data"
+if [ ! -d "$DRUGFLOW_DIR/.git" ]; then
+    echo "Cloning LPDI-EPFL/DrugFlow..."
+    git clone https://github.com/LPDI-EPFL/DrugFlow.git "$DRUGFLOW_DIR"
+fi
+git -C "$DRUGFLOW_DIR" fetch --depth=200 origin
+git -C "$DRUGFLOW_DIR" checkout "$DRUGFLOW_COMMIT"
+echo "DrugFlow pinned to ${DRUGFLOW_COMMIT}"
+
+# Public model checkpoints from Zenodo (record 14919171).
+proto_resolve_weights_dir drugflow
+for ckpt in drugflow drugflow_ood flexflow drugflow_pa_comb; do
+    if [ ! -f "$WEIGHTS_DIR/${ckpt}.ckpt" ]; then
+        echo "Downloading ${ckpt}.ckpt..."
+        wget -q -O "$WEIGHTS_DIR/${ckpt}.ckpt" \
+            "https://zenodo.org/records/14919171/files/${ckpt}.ckpt?download=1"
+    fi
+done
+
+echo "DrugFlow setup complete!"
