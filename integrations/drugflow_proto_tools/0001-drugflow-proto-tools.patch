+"""DrugFlow Modal service.
+
+Delegates to the proto-tools ``run_drugflow_generate`` function for parameter validation,
+environment setup, and model inference. DrugFlow's checkpoints are public (Zenodo record 14919171)
+and are downloaded into the ``PROTO_MODEL_CACHE`` volume when the standalone env is built; the
+build-time warmup bakes the tool source into the image, and the env (with its DrugFlow checkout and
+checkpoints) is provisioned on the first request.
+"""
+
+from typing import Any
+
+import modal
+
+from proto_tools.modal.app import HF_TOKEN_SECRET, MODEL_CACHE, SCALEDOWN_WINDOW, SERVICE_RETRIES, get_app_for_service
+from proto_tools.modal.base_images import GPU_BASE, with_proto_tools
+from proto_tools.modal.gpu_profiles import GPU_DEFAULT
+from proto_tools.modal.manifest import SERVICE_MODAL_TIMEOUTS
+from proto_tools.modal.registry import register_tools
+from proto_tools.modal.utils import RUNTIME_ENV, ensure_gpu_ready, env_for, run_tool_call
+
+
+def _warmup() -> None:
+    """Deploy-time: bake the tool source into the image (weights download on env build)."""
+    from proto_tools.tools.molecular_generation.drugflow.drugflow_generate import (  # noqa: F401
+        run_drugflow_generate,
+    )
+
+
+image = (
+    with_proto_tools(GPU_BASE)
+    .env(env_for())
+    .run_function(
+        _warmup, gpu=GPU_DEFAULT, volumes={"/weights": MODEL_CACHE}, secrets=[HF_TOKEN_SECRET], include_source=False
+    )
+    .env(RUNTIME_ENV)
+)
+
+
+app = get_app_for_service("DrugFlowService")
+
+
+@app.cls(
+    include_source=False,
+    image=image,
+    gpu=GPU_DEFAULT,
+    scaledown_window=SCALEDOWN_WINDOW,
+    volumes={"/weights": MODEL_CACHE},
+    timeout=SERVICE_MODAL_TIMEOUTS["DrugFlowService"],
+    retries=SERVICE_RETRIES,
+    secrets=[HF_TOKEN_SECRET],
+)
+@register_tools({"drugflow-generate": "generate"})
+class DrugFlowService:
+    """Modal service for DrugFlow pocket-conditioned molecule generation."""
+
+    @modal.enter()
+    def setup(self) -> None:
+        """Start a persistent worker so the DrugFlow env stays provisioned across requests."""
+        ensure_gpu_ready("drugflow")
+        from proto_tools.utils.tool_instance import ToolInstance
+
+        self._persist_ctx = ToolInstance.persist_tool("drugflow")
+        self.instance = self._persist_ctx.__enter__()
+
+    @modal.exit()
+    def teardown(self) -> None:
+        """Close the persistent worker context manager on container shutdown."""
+        self._persist_ctx.__exit__(None, None, None)
+
+    @modal.method()
+    def generate(self, input_dict: dict[str, Any], config_dict: dict[str, Any]) -> dict[str, Any]:
+        """Generate pocket-conditioned 3D molecules with DrugFlow.
+
+        Args:
+            input_dict (dict[str, Any]): Mapping of input names to their serialized values.
+            config_dict (dict[str, Any]): Mapping of configuration parameter names to values.
+
+        Returns:
+            dict[str, Any]: One generation set of molecules per input protein.
+        """
+        from proto_tools.tools.molecular_generation.drugflow.drugflow_generate import (
+            DrugFlowGenerateConfig,
+            DrugFlowGenerateInput,
+            run_drugflow_generate,
+        )
+
+        return run_tool_call(
+            run_drugflow_generate,
+            DrugFlowGenerateInput,
+            DrugFlowGenerateConfig,
+            input_dict,
+            config_dict,
+            instance=self.instance,
+        )
