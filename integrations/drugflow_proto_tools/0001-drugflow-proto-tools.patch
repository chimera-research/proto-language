+++ b/proto_tools/tools/molecular_generation/drugflow/standalone/inference.py
@@ -0,0 +1,179 @@
+"""DrugFlow pocket-conditioned molecule generation (standalone inference).
+
+DrugFlow's ``src/generate.py`` is a CLI-only entry point, so this driver writes the protein and
+reference-ligand inputs to temporary files, invokes ``generate.py`` as a subprocess against the
+cloned repo, and parses the resulting SDF of 3D poses back into SMILES + metrics.
+"""
+
+import json
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+from typing import Any
+
+from standalone_helpers import get_logger, get_random_int, resolve_weights_dir, serialize_output
+
+logger = get_logger(__name__)
+
+# Bundled Zenodo checkpoints provisioned by setup.sh into the managed weights cache.
+BUNDLED_CHECKPOINTS = {
+    "drugflow": "drugflow.ckpt",
+    "drugflow_ood": "drugflow_ood.ckpt",
+    "flexflow": "flexflow.ckpt",
+    "drugflow_pa_comb": "drugflow_pa_comb.ckpt",
+}
+
+
+def _repo_dir() -> Path:
+    """Locate the DrugFlow checkout that setup.sh cloned under the tool venv."""
+    venv = os.environ.get("TOOL_VENV_PATH") or os.environ.get("VIRTUAL_ENV")
+    if not venv:
+        raise RuntimeError("drugflow: neither TOOL_VENV_PATH nor VIRTUAL_ENV is set; invoke via ToolInstance.")
+    repo = Path(venv) / "data" / "DrugFlow"
+    if not (repo / "src" / "generate.py").is_file():
+        raise RuntimeError(f"drugflow: DrugFlow checkout not found at {repo}; re-run setup.sh.")
+    return repo
+
+
+def _resolve_checkpoint(model_checkpoint: str) -> str:
+    """Resolve a bundled checkpoint name to its cached path, or pass a custom path through."""
+    if model_checkpoint not in BUNDLED_CHECKPOINTS:
+        if not Path(model_checkpoint).is_file():
+            raise FileNotFoundError(f"drugflow: checkpoint not found at {model_checkpoint!r}")
+        return model_checkpoint
+    weights_dir = resolve_weights_dir("drugflow")
+    if weights_dir is None:
+        raise FileNotFoundError("drugflow: could not resolve a weights directory for the bundled checkpoint")
+    candidate = Path(weights_dir) / BUNDLED_CHECKPOINTS[model_checkpoint]
+    if not candidate.is_file():
+        raise FileNotFoundError(f"drugflow: bundled checkpoint {candidate} not found; re-run setup.sh.")
+    return str(candidate)
+
+
+def _parse_sdf(sdf_path: Path) -> list[dict[str, Any]]:
+    """Parse generated poses into per-molecule SMILES, mol block, and property metrics."""
+    from rdkit import Chem
+    from rdkit.Chem import QED, Descriptors
+
+    molecules: list[dict[str, Any]] = []
+    supplier = Chem.SDMolSupplier(str(sdf_path), removeHs=False, sanitize=True)
+    for mol in supplier:
+        if mol is None:
+            continue
+        try:
+            smiles = Chem.MolToSmiles(mol)
+        except Exception:  # a pose RDKit cannot canonicalize is dropped rather than failing the batch
+            continue
+        try:
+            qed = float(QED.qed(mol))
+        except Exception:
+            qed = float("nan")
+        molecules.append(
+            {
+                "smiles": smiles,
+                "pose_sdf": Chem.MolToMolBlock(mol),
+                "metrics": {
+                    "qed": qed,
+                    "molecular_weight": float(Descriptors.MolWt(mol)),
+                    "num_atoms": float(mol.GetNumHeavyAtoms()),
+                },
+            }
+        )
+    return molecules
+
+
+def generate(input_dict: dict[str, Any]) -> dict[str, Any]:
+    """Run DrugFlow's generate.py for one pocket and return the generated molecules."""
+    from standalone_helpers import get_subprocess_device_env
+
+    repo = _repo_dir()
+    checkpoint = _resolve_checkpoint(input_dict["model_checkpoint"])
+    device = input_dict["device"]
+    seed = input_dict.get("seed")
+    seed = seed if seed is not None else get_random_int()
+
+    with tempfile.TemporaryDirectory(prefix="drugflow_") as tmpdir:
+        tmp = Path(tmpdir)
+        protein_path = tmp / "protein.pdb"
+        ref_path = tmp / "ref_ligand.sdf"
+        out_path = tmp / "samples.sdf"
+        protein_path.write_text(input_dict["protein_pdb"])
+        ref_path.write_text(input_dict["reference_ligand_sdf"])
+
+        cmd = [
+            sys.executable,
+            str(repo / "src" / "generate.py"),
+            "--protein", str(protein_path),
+            "--ref_ligand", str(ref_path),
+            "--checkpoint", checkpoint,
+            "--output", str(out_path),
+            "--n_samples", str(input_dict["n_samples"]),
+            "--batch_size", str(input_dict["batch_size"]),
+            "--pocket_distance_cutoff", str(input_dict["pocket_distance_cutoff"]),
+            "--device", device,
+            "--seed", str(seed),
+        ]
+        if input_dict.get("molecule_size") is not None:
+            cmd += ["--molecule_size", str(input_dict["molecule_size"])]
+        if input_dict.get("n_steps") is not None:
+            cmd += ["--n_steps", str(input_dict["n_steps"])]
+
+        verbose = bool(input_dict.get("verbose"))
+        logger.update_status("Running DrugFlow generation")
+        logger.debug("drugflow: spawning %s", " ".join(cmd))
+        env = {**os.environ, **get_subprocess_device_env(device), "PYTHONPATH": str(repo)}
+        proc = subprocess.run(
+            cmd,
+            cwd=str(repo),
+            env=env,
+            check=False,
+            stdout=sys.stdout if verbose else subprocess.PIPE,
+            stderr=sys.stderr if verbose else subprocess.PIPE,
+            text=True,
+        )
+        if proc.returncode != 0:
+            tail = "" if verbose else (proc.stderr or "")[-2000:]
+            raise RuntimeError(f"drugflow: generate.py exited {proc.returncode}.\n{tail}")
+        if not out_path.is_file():
+            raise RuntimeError("drugflow: generate.py produced no output SDF.")
+        molecules = _parse_sdf(out_path)
+
+    return {"molecules": molecules}
+
+
+# ============================================================================
+# Dispatch
+# ============================================================================
+def dispatch(input_dict: dict[str, Any]) -> dict[str, Any]:
+    """Entry point for both persistent-worker and one-shot execution."""
+    operation = input_dict["operation"]
+    if operation == "generate":
+        return generate(input_dict)
+    raise ValueError(f"drugflow: unknown operation {operation!r}; valid: ['generate']")
+
+
+def to_device(device: str) -> dict[str, Any]:
+    """DrugFlow runs as a subprocess CLI and auto-unloads after each call."""
+    return {"success": True, "device": device, "note": "CLI subprocess, auto-unloads"}
+
+
+def get_memory_stats() -> dict[str, Any]:
+    """Report GPU memory usage (the generate.py subprocess uses the GPU)."""
+    from standalone_helpers import get_pytorch_memory_stats
+
+    return get_pytorch_memory_stats(device=0)  # type: ignore[no-any-return]
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 3:
+        raise ValueError("drugflow: usage: python inference.py <input_json_path> <output_json_path>")
+
+    with open(sys.argv[1]) as f:
+        input_data = json.load(f)
+
+    result = dispatch(input_data)
+
+    with open(sys.argv[2], "w") as f:
+        json.dump(serialize_output(result), f)
